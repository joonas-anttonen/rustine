    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Rust (cargo run)",
            "type": "lldb",
            "request": "launch",
            "program": "${cargo:program}",
            "args": [],
            "cwd": "${workspaceFolder}/Rustine",
            "cargo": {
                "args": [
                    "run",
                    "--manifest-path",
                    "${workspaceFolder}/Rustine/Cargo.toml"
                ],
                "filter": {
                    "name": "rustine-app",
                    "kind": "bin"
                }
            },
            "stdio": null,
            "initCommands": []
        }
    ]
}