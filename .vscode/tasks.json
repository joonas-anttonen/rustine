{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Clean",
			"detail": "Clean the project (via nix develop)",
			"type": "shell",
			"command": "nix develop -c cargo clean",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build",
			"detail": "Build the project (via nix develop)",
			"type": "shell",
			"command": "nix develop -c cargo build",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Rebuild",
			"detail": "Clean and build the project (via nix develop)",
			"type": "shell",
			"command": "nix develop -c bash -c \"cargo clean && cargo build\"",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run",
			"detail": "Run the application in debug mode (via nix develop)",
			"type": "shell",
			"command": "nix develop -c cargo run",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run (Release)",
			"detail": "Run the application in release mode (via nix develop)",
			"type": "shell",
			"command": "nix develop -c cargo run --release",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run Wpf",
			"detail": "Run the WPF application in debug mode",
			"type": "process",
			"command": "dotnet",
			"options": {
				"cwd": "Rustine.Wpf"
			},
			"args": [
				"run"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"dependsOn": [
				"Build"
			]
		}
	]
}