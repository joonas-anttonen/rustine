{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Clean",
			"detail": "Clean the project",
			"type": "process",
			"command": "cargo",
			"options": {
				"cwd": "Rustine"
			},
			"args": [
				"clean"
			],
			"problemMatcher": [
				"$rustc"
			],
		},
		{
			"label": "Build",
			"detail": "Build the project",
			"type": "process",
			"command": "cargo",
			"options": {
				"cwd": "Rustine"
			},
			"args": [
				"build"
			],
			"problemMatcher": [
				"$rustc"
			],
		},
		{
			"label": "Rebuild",
			"detail": "Clean and build the project",
			"type": "shell",
			"command": "cargo clean; cargo build",
			"options": {
				"cwd": "Rustine"
			},
			"problemMatcher": [
				"$rustc"
			],
		},
		{
			"label": "Run",
			"detail": "Run the application in debug mode",
			"type": "process",
			"command": "cargo",
			"options": {
				"cwd": "Rustine"
			},
			"args": [
				"run"
			],
			"problemMatcher": [
				"$rustc"
			],
		},
		{
			"label": "Run (Release)",
			"detail": "Run the application in release mode",
			"type": "process",
			"command": "cargo",
			"options": {
				"cwd": "Rustine"
			},
			"args": [
				"run",
				"--release"
			],
			"problemMatcher": [
				"$rustc"
			],
		}
	]
}