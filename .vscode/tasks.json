{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Clean",
			"detail": "Clean the project",
			"type": "shell",
			"command": "cargo clean",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build",
			"detail": "Build the project",
			"type": "cargo",
			"command": "build",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Rebuild",
			"detail": "Clean and build the project",
			"type": "shell",
			"command": "bash -c \"cargo clean && cargo build\"",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run",
			"detail": "Run the application in debug mode",
			"type": "shell",
			"command": "cargo run",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run (Release)",
			"detail": "Run the application in release mode",
			"type": "shell",
			"command": "cargo run --release",
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run Wpf",
			"detail": "Run the WPF application in debug mode",
			"type": "process",
			"command": "dotnet",
			"options": {
				"cwd": "Rustine.Wpf"
			},
			"args": [
				"run"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"dependsOn": [
				"Build"
			]
		}
	]
}