{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Clean rustine",
			"detail": "Clean rustine",
			"type": "process",
			"command": "cargo",
			"args": [
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}/rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Clean rustine-desktop",
			"detail": "Clean rustine-desktop",
			"type": "process",
			"command": "cargo",
			"args": [
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}/rustine-desktop"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Rebuild",
			"detail": "Rebuild the whole project",
			"dependsOn": [
				"Clean rustine",
				"Clean rustine-desktop",
				"Build rustine",
				"Build rustine-desktop"
			],
			"dependsOrder": "sequence",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build rustine",
			"detail": "Build rustine in debug mode",
			"type": "process",
			"command": "cargo",
			"args": [
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}/rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run rustine",
			"detail": "Run rustine in debug mode",
			"type": "process",
			"command": "cargo",
			"args": [
				"run"
			],
			"options": {
				"cwd": "${workspaceFolder}/rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build rustine-desktop",
			"detail": "Build rustine-desktop in debug mode",
			"type": "process",
			"command": "cargo",
			"args": [
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}/rustine-desktop"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run rustine-desktop",
			"detail": "Run rustine-desktop in release mode",
			"type": "process",
			"command": "cargo",
			"args": [
				"run",
				"--release"
			],
			"options": {
				"cwd": "${workspaceFolder}/rustine-desktop"
			},
			"problemMatcher": [
				"$rustc"
			]
		}
	]
}