{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Clean",
			"detail": "Clean the project",
			"type": "process",
			"command": "cargo",
			"args": [
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Build",
			"detail": "Build the project",
			"type": "process",
			"command": "cargo",
			"args": [
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Rebuild",
			"detail": "Rebuild the project",
			"dependsOn": [
				"Clean",
				"Build"
			],
			"dependsOrder": "sequence",
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run",
			"detail": "Run the application in debug mode",
			"type": "process",
			"command": "cargo",
			"args": [
				"run"
			],
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run (Release)",
			"detail": "Run the application in release mode",
			"type": "process",
			"command": "cargo",
			"args": [
				"run",
				"--release"
			],
			"options": {
				"cwd": "${workspaceFolder}/Rustine"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "Run Wpf",
			"detail": "Run the WPF application in debug mode",
			"type": "process",
			"command": "dotnet",
			"options": {
				"cwd": "Rustine.Wpf"
			},
			"args": [
				"run"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"dependsOn": [
				"Build"
			]
		}
	]
}