<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Copy the native rustine.dll from Rust build output into WPF output -->
  <PropertyGroup>
    <!-- Base path to the Rust project -->
    <RustProjectDir>$(MSBuildProjectDirectory)\..\Rustine</RustProjectDir>
    <!-- Target subfolder based on configuration -->
    <RustTargetSubdir Condition="'$(Configuration)' == 'Debug'">debug</RustTargetSubdir>
    <RustTargetSubdir Condition="'$(Configuration)' == 'Release'">release</RustTargetSubdir>
    <!-- Full path to the built DLL -->
    <RustDllPath>$(RustProjectDir)\target\$(RustTargetSubdir)\rustine.dll</RustDllPath>
  </PropertyGroup>

  <Target Name="CopyRustDll" AfterTargets="Build">
    <Message Text="Copying rustine.dll from $(RustDllPath) to $(OutputPath)" Importance="high" />
    <Copy SourceFiles="$(RustDllPath)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="CopiedRustDll" />
    </Copy>
    <Warning Condition="!Exists('$(RustDllPath)')" Text="rustine.dll not found at $(RustDllPath). Build the Rust project (cargo build) before running the WPF app." />
  </Target>

</Project>
